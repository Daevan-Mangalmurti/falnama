{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Falnama Paper Recommended Trade Row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_time_utc",
    "market_name",
    "card_id",
    "card_hash",
    "asset",
    "asset_class",
    "expected_direction",
    "expected_return_12h_bps",
    "confidence",
    "position_score",
    "recommended_notional_usd",
    "paper_trade_action"
  ],
  "properties": {
    "run_time_utc": {
      "type": "string"
    },
    "trigger_time_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_id": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "market_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_name": {
      "type": "string"
    },
    "anomaly_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "anomaly_rank_or_score": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "card_id": {
      "type": "string"
    },
    "card_created_time_utc": {
      "type": "string"
    },
    "card_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asset": {
      "type": "string"
    },
    "ticker": {
      "type": [
        "string",
        "null"
      ]
    },
    "tradable_instrument_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_class": {
      "enum": [
        "equity",
        "etf",
        "equity_index",
        "fx_proxy",
        "commodity",
        "other"
      ]
    },
    "expected_direction": {
      "enum": [
        "up",
        "down"
      ]
    },
    "expected_return_12h_bps": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "normalized_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "normalized_expected_magnitude": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "normalized_anomaly_strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "position_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recommended_notional_usd": {
      "type": "number",
      "minimum": 0
    },
    "paper_trade_action": {
      "enum": [
        "PAPER_BUY_OR_LONG",
        "PAPER_SELL_OR_SHORT"
      ]
    }
  }
}
